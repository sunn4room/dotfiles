awful.screen.connect_for_each_screen(function(s)
  set_wallpaper(s)

  s.mytaglist = awful.widget.taglist {
    screen  = s,
    filter  = awful.widget.taglist.filter.all,
    buttons = taglist_buttons
  }
  s.mytasklist = awful.widget.tasklist {
    screen  = s,
    filter  = awful.widget.tasklist.filter.currenttags,
    buttons = tasklist_buttons
  }
  s.mylayoutbox = wibox.widget.textbox(" [?] ")
  s.mylayoutbox:connect_signal("button::press", function()
    awful.layout.inc(1)
  end)
  local update_layout = function()
    local current_tag = awful.screen.focused().selected_tag
    if current_tag then
      local layout_index = awful.layout.get_tag_layout_index(current_tag)
      if layout_index == 1 then
        s.mylayoutbox:set_text(" [ ] ")
      elseif layout_index == 2 then
        s.mylayoutbox:set_text(" [|] ")
      else
        s.mylayoutbox:set_text(" [+] ")
      end
    else
      s.mylayoutbox:set_text(" [?] ")
    end
  end
  awful.tag.attached_connect_signal(s, "property::selected", update_layout)
  awful.tag.attached_connect_signal(s, "property::layout", update_layout)

  local tags = awful.tag({ "1", "2", "3", "4", "5", "6", "7", "8", "9", "0" }, s, awful.layout.suit.max)
  tags[10].layout = awful.layout.suit.fair

